Yes—appending decoded binlog SQL statements to a local append-only file (events.sql) and letting each peer region tail that file from its own byte offset is one of the cleanest, zero-dependency designs possible.
Instead of Redis, mkfifo, or complex outbox tables, a plain text file on disk acts as your durable queue, and 3 tiny byte-offset numbers (one per peer) tell each SSH tunnel worker the exact line/byte where it left off if a connection drops.

How the Plain-File + Byte-Offset Design Works

Show Code
Download diagram SVG
1. One Producer (binlog_to_file.sh): Streams mysqlbinlog --stop-never, filters for local origin_node_id, converts events into single-line SQL statements, and appends them to /var/lib/db_sync/events.sql.
2. Three Independent Consumers (file_to_peer.sh): Each remote region gets its own tiny state file (e.g., sydney.offset containing just a byte number like 14820). It uses tail -n +$LINE -f events.sql to stream lines over the SSH tunnel into a persistent mysql CLI process, updating its line counter as statements are sent.
3. Zero Blocking Between Regions: If Sydney's SSH tunnel drops for 20 minutes, US and Asia keep streaming at full speed. When Sydney's tunnel reconnects, file_to_peer.sh reads sydney.offset and immediately replays from that exact line.

1. Producer: Append Binlog SQL to Local File (binlog_to_file.sh)

Run one instance of this on each VM. It writes clean, single-line SQL statements to /var/lib/db_sync/events.sql.
sh
#!/bin/sh
set -eu

NODE_ID="node1"
SRC_CNF="$HOME/.my-local.cnf"
DB_NAME="defaultdb"
SYNC_DIR="/var/lib/db_sync"
BINLOG_STATE="$SYNC_DIR/binlog_${NODE_ID}.state"
EVENTS_FILE="$SYNC_DIR/events.sql"

mkdir -p "$SYNC_DIR"
touch "$EVENTS_FILE"

if [ ! -f "$BINLOG_STATE" ]; then
    mysql --defaults-extra-file="$SRC_CNF" -N -e "SHOW MASTER STATUS;" \
        | awk '{print $1, $2}' > "$BINLOG_STATE"
fi

while true; do
    read -r START_FILE START_POS < "$BINLOG_STATE"
    echo "$(date -u +"%Y-%m-%dT%H:%M:%SZ") [$NODE_ID] Appending $START_FILE @ $START_POS to $EVENTS_FILE..."

    SCHEMA_TMP=$(mktemp)
    mysql --defaults-extra-file="$SRC_CNF" -N --batch --skip-column-names -e "
        SELECT c.TABLE_NAME, c.ORDINAL_POSITION, c.COLUMN_NAME,
               IF(k.COLUMN_NAME IS NOT NULL, 1, 0)
        FROM INFORMATION_SCHEMA.COLUMNS c
        LEFT JOIN INFORMATION_SCHEMA.KEY_COLUMN_USAGE k
          ON c.TABLE_SCHEMA = k.TABLE_SCHEMA AND c.TABLE_NAME = k.TABLE_NAME
          AND c.COLUMN_NAME = k.COLUMN_NAME AND k.CONSTRAINT_NAME = 'PRIMARY'
        WHERE c.TABLE_SCHEMA = '$DB_NAME'
        ORDER BY c.TABLE_NAME, c.ORDINAL_POSITION;" > "$SCHEMA_TMP"

    mysqlbinlog \
        --defaults-extra-file="$SRC_CNF" \
        --read-from-remote-server \
        --stop-never \
        --database="$DB_NAME" \
        --start-position="$START_POS" \
        --base64-output=DECODE-ROWS \
        --verbose \
        "$START_FILE" | \
    awk -v schema="$SCHEMA_TMP" -v state="$BINLOG_STATE" -v file="$START_FILE" -v node="$NODE_ID" '
    BEGIN {
        while ((getline line < schema) > 0) {
            split(line, f, "\t");
            t = f; idx = f; cname = f; is_pk = f;
            cols[t, idx] = cname;
            if (idx > max_col[t]) max_col[t] = idx;
            if (is_pk == "1") pk[t] = cname;
            if (cname == "origin_node_id") origin_idx[t] = idx;
        }
        close(schema);
    }
    function emit_sql(    i, c, v, col_list, val_list, upd_list, pk_val) {
        if (op == "" || tbl == "" || !(tbl in max_col)) return;
        oidx = origin_idx[tbl];
        if (oidx == "" || vals[oidx] != "\x27" node "\x27") return;

        if (op == "INSERT" || op == "UPDATE") {
            col_list = ""; val_list = ""; upd_list = "";
            for (i = 1; i <= max_col[tbl]; i++) {
                c = cols[tbl, i];
                v = (i in vals) ? vals[i] : "NULL";
                col_list = col_list (i > 1 ? ", " : "") "`" c "`";
                val_list = val_list (i > 1 ? ", " : "") v;
                if (c != pk[tbl] && c != "updated_at_utc" && c != "origin_node_id") {
                    upd_list = upd_list (upd_list != "" ? ", " : "") \
                        "`" c "` = IF(VALUES(`updated_at_utc`) > `updated_at_utc` OR (VALUES(`updated_at_utc`) = `updated_at_utc` AND VALUES(`origin_node_id`) > `origin_node_id`), VALUES(`" c "`), `" c "`)";
                }
            }
            upd_list = upd_list ", `origin_node_id` = IF(VALUES(`updated_at_utc`) > `updated_at_utc` OR (VALUES(`updated_at_utc`) = `updated_at_utc` AND VALUES(`origin_node_id`) > `origin_node_id`), VALUES(`origin_node_id`), `origin_node_id`)" \
                                ", `updated_at_utc` = GREATEST(`updated_at_utc`, VALUES(`updated_at_utc`))";
            printf "INSERT INTO `%s` (%s) VALUES (%s) ON DUPLICATE KEY UPDATE %s;\n", tbl, col_list, val_list, upd_list;
            fflush();
        } else if (op == "DELETE") {
            for (i = 1; i <= max_col[tbl]; i++) {
                if (cols[tbl, i] == pk[tbl]) { pk_val = vals[i]; break; }
            }
            if (pk_val != "") {
                printf "DELETE FROM `%s` WHERE `%s` = %s;\n", tbl, pk[tbl], pk_val;
                fflush();
            }
        }
    }
    /^# Rotate to / { match($0, /Rotate to [^ ]+/); file = substr($0, RSTART + 10, RLENGTH - 10); }
    /^# at [0-9]+/ { emit_sql(); op = ""; tbl = ""; delete vals; print file, $3 > state; close(state); }
    /^### INSERT INTO / { emit_sql(); delete vals; op = "INSERT"; split($0, a, "."); tbl = a; gsub(/`/, "", tbl); section = "SET"; next; }
    /^### UPDATE / { emit_sql(); delete vals; op = "UPDATE"; split($0, a, "."); tbl = a; gsub(/`/, "", tbl); section = "WHERE"; next; }
    /^### DELETE FROM / { emit_sql(); delete vals; op = "DELETE"; split($0, a, "."); tbl = a; gsub(/`/, "", tbl); section = "WHERE"; next; }
    /^### SET$/ { section = "SET"; next; }
    /^### WHERE$/ { section = "WHERE"; next; }
    /^###   @[0-9]+=/ {
        if (op == "UPDATE" && section != "SET") next;
        line = $0; sub(/^###   @/, "", line); eq = index(line, "=");
        idx = substr(line, 1, eq - 1) + 0; raw_v = substr(line, eq + 1);
        sub(/ \/\*.*\*\/$/, "", raw_v); vals[idx] = raw_v; next;
    }
    ' >> "$EVENTS_FILE" || true

    rm -f "$SCHEMA_TMP"
    sleep 3
done
