Install this script on non-init webservers at /usr/local/sbin/dbaas-route-failover.sh. It works with 1, 2, 5, or any number of init webservers automatically:
bash
#!/bin/bash
# /usr/local/sbin/dbaas-route-failover.sh

DB_HOST="<YOUR_DBAAS_HOSTNAME_OR_IP>"
GATEWAY_LIST_FILE="/etc/dbaas_init_gateways.list"
STATE_FILE="/run/dbaas_active_routes"

touch "${STATE_FILE}"

while true; do
    # Optional: Refresh gateway IP list from S3 datastore periodically
    # /usr/bin/s3cmd get --force "s3://${S3_BUCKET}/gateways/${REGION}/*.ip" /tmp/gw/ >/dev/null 2>&1 && cat /tmp/gw/*.ip | sort -u > "${GATEWAY_LIST_FILE}"

    # 1. Pick the first responsive 'init' webserver from the list
    ACTIVE_GW=""
    if [[ -s "${GATEWAY_LIST_FILE}" ]]; then
        while IFS= read -r GW_IP; do
            [[ -z "${GW_IP}" ]] && continue
            if ping -c 1 -W 1 "${GW_IP}" >/dev/null 2>&1; then
                ACTIVE_GW="${GW_IP}"
                break
            fi
        done < "${GATEWAY_LIST_FILE}"
    fi

    if [[ -z "${ACTIVE_GW}" ]]; then
        sleep 2
        continue
    fi

    # 2. Resolve DBaaS hostname to IPv4(s) (handles both static IPs and Aurora DNS)
    if [[ "${DB_HOST}" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        CURRENT_IPS="${DB_HOST}"
    else
        CURRENT_IPS=$(getent ahostsv4 "${DB_HOST}" | awk '{print $1}' | sort -u)
    fi

    # 3. Point DBaaS traffic through the healthy 'init' gateway
    DESIRED_STATE=""
    for IP in ${CURRENT_IPS}; do
        ip route replace "${IP}/32" via "${ACTIVE_GW}"
        DESIRED_STATE+="${IP}:${ACTIVE_GW}"$'\n'
    done

    # 4. Remove stale routes if DBaaS DNS rotated IPs
    while IFS=: read -r OLD_IP OLD_GW; do
        if [[ -n "${OLD_IP}" ]] && ! echo "${CURRENT_IPS}" | grep -qx "${OLD_IP}"; then
            ip route del "${OLD_IP}/32" 2>/dev/null || true
        fi
    done < "${STATE_FILE}"

    printf "%s" "${DESIRED_STATE}" > "${STATE_FILE}"
    sleep 3
done
Use code with caution.
Enable it as a systemd service on autoscaled webservers:
bash
chmod +x /usr/local/sbin/dbaas-route-failover.sh

cat << 'EOF' > /etc/systemd/system/dbaas-route-failover.service
[Unit]
Description=DBaaS Multi-Init Gateway Failover
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/dbaas-route-failover.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now dbaas-route-failover.service
